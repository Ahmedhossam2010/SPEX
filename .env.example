# ==============================================================================
# SPHEREx: The Changing Sky (SPEX) — Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development (`.env` is gitignored).
# Never commit real API keys or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Guide (Server-Side Only — server.ts)
# ------------------------------------------------------------------------------
# Optional for app boot (falls back to deterministic astrophysical templates).
# Required for live Gemini responses on POST /api/spex/chat & POST /api/spex/explain.
# Obtain a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by POST /api/spex/explain (canvas pixel explainer, JSON schema mode).
# Leave blank to use code default: gemini-4-hydrogen
GEMINI_MODEL=

# Primary & fallback models used by POST /api/spex/chat (SPEX companion chat).
# Leave blank to use code defaults: gemini-3.1-flash-lite and gemini-3.1-flash-lite
PRIMARY_MODEL=
SECONDARY_MODEL=

# ------------------------------------------------------------------------------
# 2. NASA/IPAC IRSA SPHEREx Archive (Optional — Safe Defaults Built In)
# ------------------------------------------------------------------------------
# Base origin for IRSA TAP queries (no trailing slash).
SPHEREX_IRSA_HOST=https://irsa.ipac.caltech.edu

# Authoritative IRSA SPHEREx TAP tables (joined on planeid).
SPHEREX_ARTIFACT_TABLE=spherex.artifact
SPHEREX_PLANE_TABLE=spherex.plane

# Release deduplication priority (comma-separated, newest release first).
SPHEREX_RELEASE_PREFERENCE=dr1,qr3,qr2

# Human-readable release label & ID surfaced in /api/health and provenance metadata.
SPHEREX_DATA_RELEASE="SPHEREx Public Archive (DR1 / QR3 / QR2 Level 2B)"
SPHEREX_RELEASE_ID=SPHEREx-Public-Level2B

# Used by src/science/dataSourceAdapter.ts (optional).
SPHEREX_RELEASE_NAME="SPHEREx Public Archive (DR1 / QR3 / QR2 Level 2B)"
SPHEREX_RELEASE_BASE_URL=https://irsa.ipac.caltech.edu

# Set to 1 to run strictly against local snapshots/fixtures without calling IRSA.
# Use 0 (or leave unset) for live NASA/IPAC IRSA queries.
SPHEREX_OFFLINE=0

# Set to 1 to skip background prefetching of the 5 preset targets at server boot.
SPHEREX_SKIP_WARMUP=0

# ------------------------------------------------------------------------------
# 3. Deprecated / Ambiguous Legacy Variables (Leave Unset)
# ------------------------------------------------------------------------------
# Deprecated fallback alias for SPHEREX_PLANE_TABLE (ignored by data_drop_check.ts):
# SPHEREX_TAP_TABLE=spherex.plane

# Ambiguous base URL across legacy helpers (server.ts defaults to .../ibe/data/spherex,
# ArchiveAdapter expects host origin, timeSeriesPipeline expects .../qr2).
# Keep unset and use SPHEREX_IRSA_HOST instead:
# SPHEREX_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Server Runtime & Script Overrides (Optional)
# ------------------------------------------------------------------------------
# Server listening port (AI Studio requires 3000; Dockerfile/Cloud Run sets 8080).
# PORT=3000

# Runtime mode: development | production | test
# NODE_ENV=development

# Set to true in AI Studio preview to disable Vite HMR file watching.
# DISABLE_HMR=true

# Ephemeral /tmp/spherex_cache size limit in MiB (or exact bytes via SPHEREX_CACHE_MAX_BYTES).
# Leave unset to use safe default: 256 MiB.
# SPHEREX_CACHE_MAX_MB=256
# SPHEREX_CACHE_MAX_BYTES=268435456

# Optional overrides for helper scripts (scripts/build_snapshot.ts, e2e_smoke.mjs):
# SNAPSHOT_SERVER_URL=http://127.0.0.1:3000
# E2E_URL=http://127.0.0.1:3000
# PLAYWRIGHT_EXECUTABLE_PATH=