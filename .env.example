# Runtime server port (3000 in local/AI Studio dev; 8080 default on Cloud Run)
PORT=3000

# NASA/IPAC IRSA SPHEREx Archive Configuration (zero-code release switching - B12)
SPHEREX_IRSA_HOST=https://irsa.ipac.caltech.edu
SPHEREX_ARTIFACT_TABLE=spherex.artifact
SPHEREX_PLANE_TABLE=spherex.plane
SPHEREX_RELEASE_PREFERENCE=dr1,qr3,qr2
SPHEREX_RELEASE_NAME=SPHEREx Public Archive (DR1 / QR3 / QR2 Level 2B)
SPHEREX_RELEASE_ID=dr1

# Offline & Warmup Controls (set to 1 only for isolated testing / CI)
SPHEREX_OFFLINE=0
SPHEREX_SKIP_WARMUP=0

# Optional Server-Side Gemini AI Companion Key (do NOT commit real keys)
GEMINI_API_KEY=
PRIMARY_MODEL=
SECONDARY_MODEL=