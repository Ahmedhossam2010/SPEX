# ==============================================================================
# SPEX — SPHEREx: The Changing Sky — Environment Configuration
# Copy to .env only if you want to customize defaults.
# The application runs completely with NO keys using saved snapshots & fallbacks.
# ==============================================================================

# HTTP server port (defaults to 3000; Cloud Run injects PORT=8080 automatically)
PORT=3000

# Runtime mode: development | production | test
NODE_ENV=development

# Optional Gemini API key (get one from Google AI Studio); leaves blank for offline template explanations in Mr. SPEX guide/chat
GEMINI_API_KEY=

# Optional Gemini model override for POST /api/spex/explain interactive spot explanations
GEMINI_MODEL=

# Optional primary Gemini model for POST /api/spex/chat companion replies
PRIMARY_MODEL=

# Optional secondary fallback Gemini model for POST /api/spex/chat companion replies
SECONDARY_MODEL=

# NASA/IPAC IRSA host URL used by live TAP and IBE FITS cutout queries
SPHEREX_IRSA_HOST=https://irsa.ipac.caltech.edu

# Base URL for IRSA SPHEREx FITS image cutout downloads (Explore & Science pipeline)
SPHEREX_BASE_URL=https://irsa.ipac.caltech.edu/ibe/data/spherex

# Base URL reported by archive release adapter provenance checks
SPHEREX_RELEASE_BASE_URL=https://irsa.ipac.caltech.edu

# Human-readable data release label displayed in provenance & health responses
SPHEREX_DATA_RELEASE=SPHEREx Public Archive (DR1 / QR3 / QR2 Level 2B)

# Archive release display name override for DataSourceAdapter metadata
SPHEREX_RELEASE_NAME=SPHEREx Public Archive (DR1 / QR3 / QR2 Level 2B)

# Machine-readable release identifier shown in About, Provenance, and /api/health
SPHEREX_RELEASE_ID=SPHEREx-Public-Level2B

# IRSA TAP plane metadata table queried for observation footprints and epochs
SPHEREX_PLANE_TABLE=spherex.plane

# IRSA TAP artifact table joined for FITS file URIs and detector bands
SPHEREX_ARTIFACT_TABLE=spherex.artifact

# Legacy alias for SPHEREX_PLANE_TABLE (used only if SPHEREX_PLANE_TABLE is unset)
SPHEREX_TAP_TABLE=spherex.plane

# Comma-separated release priority order (newest first) for deduplication
SPHEREX_RELEASE_PREFERENCE=dr1,qr3,qr2

# Set to 1 to force offline snapshot & cached-FITS mode without calling IRSA/VizieR
SPHEREX_OFFLINE=0

# Set to 1 to skip background benchmark cache warmup on server startup
SPHEREX_SKIP_WARMUP=0

# Lifetime in milliseconds for in-memory IRSA TAP metadata cache (default: 300000 = 5 min)
SPHEREX_TAP_CACHE_TTL_MS=300000

# Optional directory for runtime LRU FITS cache (defaults to /tmp/spherex_cache)
SPHEREX_CACHE_DIR=

# Optional directory of pre-seeded FITS fixtures (defaults to ./data/spherex_cache)
SPHEREX_PERSISTENT_CACHE_DIR=

# Optional FITS cache capacity cap in bytes (takes precedence over SPHEREX_CACHE_MAX_MB)
SPHEREX_CACHE_MAX_BYTES=

# FITS cache capacity cap in MiB when SPHEREX_CACHE_MAX_BYTES is unset (default: 256)
SPHEREX_CACHE_MAX_MB=256